<?xml version="1.0" encoding="utf-8"?>
<!-- A chosen word in a panel: the same 8% grey as a chosen icon, as a rounded pill. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/item_pressed">
    <item android:id="@android:id/mask">
        <shape><corners android:radius="16dp" /><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape><corners android:radius="16dp" /><solid android:color="@color/item_selected" /></shape>
            </item>
        </selector>
    </item>
</ripple>
