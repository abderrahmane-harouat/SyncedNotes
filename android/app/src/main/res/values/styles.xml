<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A 30dp button with a 24dp icon drawn at its natural size, as in Samsung's panel. -->
    <style name="PanelButton">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">@drawable/toolbar_item_background</item>
        <item name="android:tint">@color/icon_tint</item>
    </style>

    <style name="ToolbarButton" parent="PanelButton">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
    </style>

    <style name="PanelGroup">
        <item name="android:layout_height">40dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:background">@drawable/panel_group_background</item>
    </style>
</resources>
