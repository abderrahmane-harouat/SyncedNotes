<?xml version="1.0" encoding="utf-8"?>
<!-- The note canvas, and Samsung's floating rich-text toolbar under it (above the keyboard). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/note_background"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/canvas_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <HorizontalScrollView
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/toolbar_background"
        android:elevation="4dp"
        android:fadingEdgeLength="20dp"
        android:fillViewport="true"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton android:id="@+id/checklist" style="@style/ToolbarButton"
            android:contentDescription="@string/checklist" android:src="@drawable/ic_checklist" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="15dp" />
        <ImageButton android:id="@+id/text_options" style="@style/ToolbarButton"
            android:contentDescription="@string/text_options" android:src="@drawable/ic_text_options" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="15dp" />
        <FrameLayout android:id="@+id/font_color" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/toolbar_item_background" android:contentDescription="@string/font_color">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_font_color" android:tint="@color/icon_tint" android:importantForAccessibility="no" />
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_color_bar_outline" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/font_color_bar" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center" android:src="@drawable/ic_color_bar_fill" android:importantForAccessibility="no" />
        </FrameLayout>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="15dp" />
        <FrameLayout android:id="@+id/font_highlight" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/toolbar_item_background" android:contentDescription="@string/font_background">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_font_highlight" android:tint="@color/icon_tint" android:importantForAccessibility="no" />
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                android:src="@drawable/ic_color_bar_outline" android:importantForAccessibility="no" />
            <ImageView android:id="@+id/font_highlight_bar" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="center" android:src="@drawable/ic_color_bar_fill" android:importantForAccessibility="no" />
        </FrameLayout>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="15dp" />
        <!-- "17" with a small triangle on its right, like Samsung's size spinner. -->
        <FrameLayout android:id="@+id/font_size" android:layout_width="wrap_content" android:layout_height="32dp"
            android:minWidth="32dp" android:background="@drawable/toolbar_item_background"
            android:contentDescription="@string/font_size">
            <TextView android:id="@+id/font_size_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_vertical" android:layout_marginEnd="10dp" android:minWidth="20dp"
                android:gravity="center" android:textColor="@color/size_label" android:textSize="17dp" />
            <ImageView android:layout_width="8dp" android:layout_height="6dp" android:layout_gravity="end|center_vertical"
                android:src="@drawable/ic_drop_down" android:importantForAccessibility="no" />
        </FrameLayout>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="15dp" />
        <ImageButton android:id="@+id/undo" style="@style/ToolbarButton"
            android:contentDescription="@string/undo" android:src="@drawable/ic_undo" />
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:minWidth="15dp" />
        <ImageButton android:id="@+id/redo" style="@style/ToolbarButton"
            android:contentDescription="@string/redo" android:src="@drawable/ic_redo" />
    </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
